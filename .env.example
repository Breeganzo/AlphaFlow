# AlphaFlow — Environment Variables
# Copy this file to .env and fill in your actual API keys:
#   cp .env.example .env
#
# NEVER commit .env to git — it is in .gitignore
#
# REQUIRED to run AlphaFlow: GROQ_API_KEY
# OPTIONAL for live intraday data + paper trading: ALPACA_* keys

# ── Groq LLM (FREE tier) ──────────────────────────────────────────────────────
# Get free keys at: https://console.groq.com/keys
# The LLM writes narrative explanations only — it never decides a trading signal.
# Two keys are supported for automatic rotation when the daily token limit is hit.
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_KEY_2=your_second_groq_api_key_here   # optional — fallback when key 1 is rate-limited

# ── Alpaca (FREE paper account at https://alpaca.markets) ─────────────────────
# Sign up at: https://app.alpaca.markets/signup → API Keys section
# Without these keys: the hourly pipeline uses yfinance 1-hour bars (free, delayed).
# With these keys:    the hourly pipeline uses Alpaca IEX free-tier bars, and
#                     paper trading (order submission) is enabled.
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets/v2

# ── Database (optional) ───────────────────────────────────────────────────────
# Postgres connection string (Neon free tier pooler URL).
# When set:  uses Postgres. When omitted: uses local SQLite (./data/app.db).
# Get a free Neon account at: https://neon.tech (no credit card required)
# Use the POOLER connection string (has -pooler in the hostname, port 5432).
# DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech:5432/neondb?sslmode=require

# ── Scheduler ─────────────────────────────────────────────────────────────────
# true  = APScheduler fires cron jobs in-process (local development).
#         Weekdays (America/New_York): daily scan 9:35 AM ET,
#         hourly scans 10:35 AM–4:35 PM ET, data refresh 9:30 PM ET.
# false = cron disabled (production default — GitHub Actions handles scheduling)
SCHEDULER_ENABLED=false

# ── Data directory (optional) ─────────────────────────────────────────────────
# Where CSV/parquet caches live. Defaults to ./data.
# On Render this is set to /tmp/alphaflow-data (ephemeral but reproducible).
# DATA_DIR=./data
