# AlphaFlow — Environment Variables
# Copy this file to .env and fill in your actual API keys:
#   cp .env.example .env
#
# NEVER commit .env to git — it is in .gitignore
#
# REQUIRED to run AlphaFlow: GROQ_API_KEY
# OPTIONAL for live intraday data: ALPACA_* keys

# ── Groq LLM (FREE tier: 100K tokens/day per key) ─────────────────────────
# Get free keys at: https://console.groq.com/keys
# Two keys are supported for automatic rotation when daily limit is hit
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_KEY_2=your_second_groq_api_key_here   # optional — fallback when key 1 hits rate limit

# ── Alpaca (FREE paper trading account at https://alpaca.markets) ──────────
# Sign up at: https://app.alpaca.markets/signup → API Keys section
# Without these keys: Phase 2 uses yfinance hourly bars (free, 15-min delayed)
# With these keys:    Phase 2 uses Alpaca IEX free tier (real-time 1-min bars)
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets/v2

# ── Alpaca live-stream switch ──────────────────────────────────────────────
# false (default) = use yfinance 1-hour bars for Phase 2 (no key needed)
# true            = use Alpaca WebSocket 1-min bars (requires Algo Trader ~$240/yr)
ALPACA_USE_LIVE=false

# ── FRED (Federal Reserve Economic Data — optional, not used in v2.0) ─────
# Placeholder for future macro-regime feature. Not needed to run the project.
# Get free key at: https://fred.stlouisfed.org/docs/api/api_key.html
# FRED_API_KEY=your_fred_api_key_here
