# AlphaFlow — Environment Variables
# Copy this file to .env and fill in your actual API keys:
#   cp .env.example .env
#
# NEVER commit .env to git — it is in .gitignore
#
# REQUIRED to run AlphaFlow: GROQ_API_KEY
# OPTIONAL for live intraday data + paper trading: ALPACA_* keys

# ── Groq LLM (FREE tier) ──────────────────────────────────────────────────────
# Get free keys at: https://console.groq.com/keys
# The LLM writes narrative explanations only — it never decides a trading signal.
# Two keys are supported for automatic rotation when the daily token limit is hit.
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_KEY_2=your_second_groq_api_key_here   # optional — fallback when key 1 is rate-limited

# ── Alpaca (FREE paper account at https://alpaca.markets) ─────────────────────
# Sign up at: https://app.alpaca.markets/signup → API Keys section
# Without these keys: the hourly pipeline uses yfinance 1-hour bars (free, delayed).
# With these keys:    the hourly pipeline uses Alpaca IEX free-tier bars, and
#                     paper trading (order submission) is enabled.
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets/v2

# ── Scheduler ─────────────────────────────────────────────────────────────────
# true  = intraday/nightly cron fires automatically (production / Render)
#         Weekdays (America/New_York): daily scan 9:35 AM ET,
#         hourly scans 10:35 AM–4:35 PM ET, data refresh 9:30 PM ET.
# false = cron disabled, run manually from the dashboard (development default)
SCHEDULER_ENABLED=false

# ── Data directory (optional) ─────────────────────────────────────────────────
# Where the SQLite DB and caches live. Defaults to ./data. On Render this is set
# to the persistent disk mount (/var/data) so the DB survives redeploys.
# DATA_DIR=./data
